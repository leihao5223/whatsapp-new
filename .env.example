VITE_QE_SEARCH_ENDPOINT=/api/search
VITE_QE_DEMO_MODE=false

# Vercel -> hosted QQ Runtime. Use HTTPS in production.
QQ_RUNNER_ENDPOINT=https://qq-runtime.your-domain.example/search

# Optional direct provider fallback if no runner is used.
QQ_SEARCH_ENDPOINT=
QQ_SEARCH_METHOD=POST
QQ_SEARCH_QUERY_PARAM=q
QQ_SEARCH_RESPONSE_MODE=json
QQ_SEARCH_API_KEY=
QQ_SEARCH_COOKIE=

# Runtime simulator settings for local protocol testing.
QQ_RUNNER_PORT=8787
QQ_RUNNER_WORKERS=2
QQ_RUNNER_CONCURRENCY=2
QQ_RUNNER_DELAY_MS=450
QQ_BRIDGE_URLS=
