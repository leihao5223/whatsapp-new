VITE_QE_SEARCH_ENDPOINT=/api/search
VITE_QE_PORT_LOGIN_ENDPOINT=/api/ports/login
VITE_QQ_RUNTIME_VIEW_ENDPOINT=https://qq-runtime.your-domain.example/view
VITE_QE_DEMO_MODE=false

# Vercel -> hosted QQ Runtime. Use HTTPS in production.
QQ_RUNNER_ENDPOINT=https://qq-runtime.your-domain.example/search

# Optional direct provider fallback if no runner is used.
QQ_SEARCH_ENDPOINT=
QQ_SEARCH_METHOD=POST
QQ_SEARCH_QUERY_PARAM=q
QQ_SEARCH_RESPONSE_MODE=json
QQ_SEARCH_API_KEY=
QQ_SEARCH_COOKIE=

# Runtime simulator settings for local protocol testing.
QQ_RUNNER_PORT=8787
# 监听地址：默认 0.0.0.0（Nginx 在 Docker 内反代宿主机时勿只用 127.0.0.1，否则易 502）
QQ_RUNNER_LISTEN_HOST=0.0.0.0
QQ_RUNNER_WORKERS=2
QQ_RUNNER_CONCURRENCY=2
QQ_RUNNER_DELAY_MS=450
QQ_BRIDGE_URLS=
QQ_SCORE_AVATAR_WEIGHT=0.5
QQ_SCORE_NAME_WEIGHT=0.3
QQ_SCORE_KEYWORD_WEIGHT=0.2
QQ_SCORE_THRESHOLD_AUTO=0.85
QQ_SCORE_THRESHOLD_REVIEW=0.65

# Encrypted target config (do not store plain query URL in code)
# Generate with: node scripts/encrypt-target-url.mjs "<target-url>" "<secret>"
AVSOV_TARGET_URL_ENC=
AVSOV_TARGET_SECRET=
AVSOV_BATCH_TOKEN=Qq1314520..0254131q
AVSOV_WORKER_COUNT=3
AVSOV_MAX_RETRIES=3
AVSOV_TIMEOUT_MS=18000
AVSOV_MIN_DELAY_MS=500
AVSOV_MAX_DELAY_MS=1300
AVSOV_PROXY_POOL=
AVSOV_HEADLESS=true
# 浏览器回退路径：同时最多开几个 Playwright Context（多 Tab）。不配则按 CPU 自动算；高配可手动加大（最大 64）
QE_PLAYWRIGHT_MAX_CONTEXTS=
# Playwright 内核：chromium（默认）| firefox | webkit。换内核后需执行：npx playwright install <内核名>
QE_PLAYWRIGHT_BROWSER=chromium

# 子账号持久化文件（默认 <项目>/.cache/auth-users.json，服务器/桌面 Runner 重启后仍保留）
# QE_AUTH_USERS_PATH=/opt/whatsapp-new/.cache/auth-users.json

# Frontend token for calling /batch/* endpoints
VITE_QE_BATCH_TOKEN=Qq1314520..0254131q
