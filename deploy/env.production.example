# QQ_RUNNER_LISTEN_HOST=127.0.0.1
# QQ_RUNNER_PORT=8787
# PLAYWRIGHT_BROWSERS_PATH=/opt/whatsapp-new/.cache/pw-browsers
# QE_AUTH_USERS_PATH=/opt/whatsapp-new/.cache/auth-users.json
# QE_LANDING_DATA_DIR=/opt/whatsapp-new/.cache/landing

AVSOV_TARGET_URL_ENC=
AVSOV_TARGET_SECRET=
AVSOV_BATCH_TOKEN=

AVSOV_WORKER_COUNT=3
AVSOV_MAX_RETRIES=3
AVSOV_TIMEOUT_MS=18000
AVSOV_MIN_DELAY_MS=500
AVSOV_MAX_DELAY_MS=1300
AVSOV_PROXY_POOL=
AVSOV_HEADLESS=true
